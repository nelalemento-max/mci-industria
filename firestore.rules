rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.email == 'mci.serviciosbolivia@gmail.com'; }

    match /metrics/visits {
      allow read: if true;
      allow create: if request.resource.data.count == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt'])
                    && request.resource.data.count == resource.data.count + 1;
    }

    match /requests/{requestId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.phone is string
                    && request.resource.data.detail is string;
      allow read, update, delete: if admin();
    }

    match /users/{userId} {
      allow read: if admin() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if admin();
    }

    match /quotes/{quoteId} {
      allow create, update, delete: if admin();
      allow read: if admin() || (signedIn() && resource.data.clientEmail == request.auth.token.email);
    }

    match /marketData/current {
      allow read: if signedIn();
      allow write: if admin();
    }
  }
}
